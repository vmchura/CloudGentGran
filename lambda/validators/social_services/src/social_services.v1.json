{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalunya Social Services Data Contract",
  "description": "JSON Schema for validating social services data from Catalonia public API",
  "type": "object",
  "required": ["registre", "tipologia", "municipi", "comarca"],
  "additionalProperties": true,
  "properties": {
    "registre": {
      "type": "string",
      "description": "Unique register identifier for the social service record",
      "minLength": 1
    },
    "tipologia": {
      "type": "string",
      "description": "Service type classification",
      "minLength": 1
    },
    "inscripcio": {
      "type": "string",
      "description": "Inscription date in YYYY-MM-DD format",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "capacitat": {
      "description": "Capacity of the service (number of places)",
      "type": "string",
      "pattern": "^\\d{1,4}$"
    },
    "municipi": {
      "type": "string",
      "description": "Municipality name",
      "minLength": 1
    },
    "comarca": {
      "type": "string",
      "description": "Comarca (county) name",
      "minLength": 1
    },
    "qualificacio": {
      "type": ["string", "null"],
      "description": "Service qualification type (public/private/concerted)"
    }
  }
}
